# Loaded by Vite/Vitest in test mode, after `.env`, so it overrides any local
# Firebase config. This keeps tests deterministic and matching CI (which has no
# config): analytics and cloud accounts stay disabled unless a test opts in.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
